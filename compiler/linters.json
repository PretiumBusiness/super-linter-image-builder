{
  "_note": "Maps Super-Linter VALIDATE_* flags to what the lean image needs. Derived from the upstream v9.0.0 Dockerfile and lib/functions/linterCommands.sh. Paths are inside the upstream image. 'check' commands run inside the built image (see checks.sh) and are the safety net for anything missing here.",
  "base_apk": ["bash", "ca-certificates", "coreutils", "curl", "file", "git", "git-lfs", "jq", "libxml2-utils", "openssh-client", "parallel", "perl"],
  "npm_groups": {
    "prettier": ["prettier"],
    "markdownlint": ["markdownlint-cli"],
    "textlint": ["textlint", "textlint-filter-rule-allowlist", "textlint-filter-rule-comments", "textlint-rule-terminology"],
    "htmlhint": ["htmlhint"],
    "stylelint": ["stylelint", "stylelint-config-standard", "stylelint-config-recommended-scss", "postcss-scss"],
    "eslint": ["eslint", "eslint-plugin-n", "eslint-plugin-prettier", "prettier", "globals", "eslint-plugin-jsonc", "@typescript-eslint/eslint-plugin", "@typescript-eslint/parser", "eslint-plugin-vue", "eslint-plugin-react", "@eslint/js", "@eslint/eslintrc"],
    "eslint_react": ["eslint-plugin-react-hooks", "eslint-plugin-jsx-a11y"]
  },
  "linters": {
    "EDITORCONFIG":           {"bins": ["/usr/bin/editorconfig-checker"], "check": ["editorconfig-checker --version"]},
    "ENV":                    {"bins": ["/usr/bin/dotenv-linter"], "check": ["dotenv-linter --version"]},
    "GITHUB_ACTIONS":         {"bins": ["/usr/bin/actionlint"], "check": ["actionlint -version"]},
    "GITHUB_ACTIONS_ZIZMOR":  {"venvs": ["zizmor"], "check": ["zizmor --version"]},
    "GITLEAKS":               {"bins": ["/usr/bin/gitleaks"], "check": ["gitleaks version"]},
    "GIT_MERGE_CONFLICT_MARKERS": {"bins": ["/usr/bin/git-merge-conflict-markers"], "check": ["test -x /usr/bin/git-merge-conflict-markers"]},
    "BASH":                   {"bins": ["/usr/bin/shellcheck"], "check": ["shellcheck --version"]},
    "SHELL_SHFMT":            {"bins": ["/usr/bin/shfmt"], "check": ["shfmt --version"]},
    "DOCKERFILE_HADOLINT":    {"bins": ["/usr/bin/hadolint"], "check": ["hadolint --version"]},
    "XML":                    {"check": ["xmllint --version"]},
    "YAML":                   {"venvs": ["yamllint"], "check": ["yamllint -c /action/lib/.automation/.yaml-lint.yml /tmp/fx/t.yml"]},

    "MARKDOWN":               {"npm": ["markdownlint"], "check": ["markdownlint -c /action/lib/.automation/.markdown-lint.yml /tmp/fx/t.md"]},
    "NATURAL_LANGUAGE":       {"npm": ["textlint"], "check": ["textlint -c /action/lib/.automation/.textlintrc /tmp/fx/t.md"]},

    "JSON":                   {"npm": ["eslint"], "check": ["eslint -c /action/lib/.automation/eslint.config.mjs /tmp/fx/t.json"]},
    "JSONC":                  {"npm": ["eslint"], "check": ["eslint -c /action/lib/.automation/eslint.config.mjs /tmp/fx/t.json"]},
    "JAVASCRIPT_ES":          {"npm": ["eslint"], "check": ["eslint -c /action/lib/.automation/eslint.config.mjs /tmp/fx/t.js"]},
    "TYPESCRIPT_ES":          {"npm": ["eslint"], "check": ["eslint -c /action/lib/.automation/eslint.config.mjs /tmp/fx/t.ts"]},
    "VUE":                    {"npm": ["eslint"], "check": ["eslint -c /action/lib/.automation/eslint.config.mjs /tmp/fx/t.js"]},
    "JSX":                    {"npm": ["eslint", "eslint_react"], "check": ["eslint -c /action/lib/.automation/eslint.config.mjs /tmp/fx/t.js"]},
    "TSX":                    {"npm": ["eslint", "eslint_react"], "check": ["eslint -c /action/lib/.automation/eslint.config.mjs /tmp/fx/t.ts"]},

    "JSON_PRETTIER":          {"npm": ["prettier"], "check": ["prettier --check /tmp/fx/t.json"]},
    "JSONC_PRETTIER":         {"npm": ["prettier"], "check": ["prettier --check /tmp/fx/t.json"]},
    "JAVASCRIPT_PRETTIER":    {"npm": ["prettier"], "check": ["prettier --check /tmp/fx/t.js"]},
    "TYPESCRIPT_PRETTIER":    {"npm": ["prettier"], "check": ["prettier --check /tmp/fx/t.ts"]},
    "JSX_PRETTIER":           {"npm": ["prettier"], "check": ["prettier --check /tmp/fx/t.js"]},
    "VUE_PRETTIER":           {"npm": ["prettier"], "check": ["prettier --version"]},
    "CSS_PRETTIER":           {"npm": ["prettier"], "check": ["prettier --check /tmp/fx/t.css"]},
    "HTML_PRETTIER":          {"npm": ["prettier"], "check": ["prettier --check /tmp/fx/t.html"]},
    "YAML_PRETTIER":          {"npm": ["prettier"], "check": ["prettier --check /tmp/fx/t.yml"]},
    "MARKDOWN_PRETTIER":      {"npm": ["prettier"], "check": ["prettier --check /tmp/fx/t.md"]},
    "CSS":                    {"npm": ["stylelint"], "check": ["stylelint --config /action/lib/.automation/stylelint.config.mjs /tmp/fx/t.css"]},
    "HTML":                   {"npm": ["htmlhint"], "check": ["htmlhint --config /action/lib/.automation/.htmlhintrc /tmp/fx/t.html"]},

    "PYTHON_BLACK":           {"venvs": ["black"], "check": ["black --version"]},
    "PYTHON_FLAKE8":          {"venvs": ["flake8"], "check": ["flake8 --version"]},
    "PYTHON_ISORT":           {"venvs": ["isort"], "check": ["isort --version"]},
    "PYTHON_MYPY":            {"venvs": ["mypy"], "check": ["mypy --version"]},
    "PYTHON_PYLINT":          {"venvs": ["pylint"], "check": ["pylint --version"]},
    "PYTHON_RUFF":            {"venvs": ["ruff"], "check": ["ruff --version"]},
    "PYTHON_RUFF_FORMAT":     {"venvs": ["ruff"], "check": ["ruff --version"]},
    "SPELL_CODESPELL":        {"venvs": ["codespell"], "check": ["codespell --version"]},

    "CPP":                    {"venvs": ["cpplint"], "check": ["cpplint --version"]},
    "CLANG_FORMAT":           {"bins": ["/usr/bin/clang-format"], "apk": ["libstdc++", "libgcc"], "check": ["clang-format --version"]},

    "JAVA":                   {"bins": ["/usr/bin/checkstyle"], "apk": ["openjdk21-jre"], "check": ["java -jar /usr/bin/checkstyle --version"]},
    "GOOGLE_JAVA_FORMAT":     {"bins": ["/usr/bin/google-java-format"], "apk": ["openjdk21-jre"], "check": ["java -jar /usr/bin/google-java-format --version"]},

    "CSHARP":                 {"dirs": ["/usr/share/dotnet"], "upstream": "standard", "baseline": "standard", "apk": ["icu-libs", "krb5-libs", "libgcc", "libintl", "libstdc++", "zlib"], "path": ["/var/cache/dotnet/tools", "/usr/share/dotnet"], "env": {"DOTNET_CLI_TELEMETRY_OPTOUT": "1"}, "check": ["dotnet --version"]},
    "DOTNET_SLN_FORMAT_ANALYZERS":  {"dirs": ["/usr/share/dotnet"], "upstream": "standard", "baseline": "standard", "apk": ["icu-libs", "krb5-libs", "libgcc", "libintl", "libstdc++", "zlib"], "path": ["/var/cache/dotnet/tools", "/usr/share/dotnet"], "env": {"DOTNET_CLI_TELEMETRY_OPTOUT": "1"}, "check": ["dotnet --version"]},
    "DOTNET_SLN_FORMAT_STYLE":      {"dirs": ["/usr/share/dotnet"], "upstream": "standard", "baseline": "standard", "apk": ["icu-libs", "krb5-libs", "libgcc", "libintl", "libstdc++", "zlib"], "path": ["/var/cache/dotnet/tools", "/usr/share/dotnet"], "env": {"DOTNET_CLI_TELEMETRY_OPTOUT": "1"}, "check": ["dotnet --version"]},
    "DOTNET_SLN_FORMAT_WHITESPACE": {"dirs": ["/usr/share/dotnet"], "upstream": "standard", "baseline": "standard", "apk": ["icu-libs", "krb5-libs", "libgcc", "libintl", "libstdc++", "zlib"], "path": ["/var/cache/dotnet/tools", "/usr/share/dotnet"], "env": {"DOTNET_CLI_TELEMETRY_OPTOUT": "1"}, "check": ["dotnet --version"]},

    "RUST_2015":              {"apk": ["rustfmt"], "baseline": "standard", "check": ["rustfmt --version"]},
    "RUST_2018":              {"apk": ["rustfmt"], "baseline": "standard", "check": ["rustfmt --version"]},
    "RUST_2021":              {"apk": ["rustfmt"], "baseline": "standard", "check": ["rustfmt --version"]},
    "RUST_2024":              {"apk": ["rustfmt"], "baseline": "standard", "check": ["rustfmt --version"]},
    "RUST_CLIPPY":            {"apk": ["rust-clippy", "rustfmt"], "baseline": "standard", "check": ["cargo clippy --version"]}
  }
}
