# Tools Super-Linter does not ship, added on top of the opinionated base.
# EXTRA_APK / EXTRA_NPM / EXTRA_PIP are installed at build time (not at run time),
# and every EXTRA_CHECK line must succeed in the built image.
EXTRA_APK="tree"
EXTRA_NPM="left-pad@1.3.0"
EXTRA_PIP="yq==3.4.3"
EXTRA_CHECK="tree --version"
EXTRA_CHECK="yq --version"
EXTRA_CHECK="test -d /opt/extras/npm/node_modules/left-pad"
