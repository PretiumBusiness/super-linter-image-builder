# Hand-built "lean" overlay for the ghwm linter set (issue #2).
#
# Approach: start from the same Python/Alpine base that upstream Super-Linter
# uses, then COPY only the tool paths this config needs out of the published
# upstream slim image. Nothing is compiled here, so the result is pinned to the
# upstream release.
#
# Build:
#   docker build -f overlay/Dockerfile.ghwm \
#     --build-arg UPSTREAM_TAG=v9.0.0 -t lean-ghwm .
#
# Upstream references (v9.0.0 Dockerfile):
#   base          python:3.14.7-alpine3.24 (stage "python-base")
#   binaries      /usr/bin/{editorconfig-checker,dotenv-linter,actionlint,gitleaks}
#   python venvs  /venvs/<tool>   (zizmor, mypy, ruff, yamllint)
#   npm tools     /node_modules   (markdownlint, prettier, textlint, eslint, ...)
#   entrypoint    /action/lib/linter.sh, rules in /action/lib/.automation

ARG UPSTREAM_TAG=v9.0.0
ARG PYTHON_BASE=python:3.14.7-alpine3.24

FROM ghcr.io/super-linter/super-linter:slim-${UPSTREAM_TAG} AS upstream

FROM ${PYTHON_BASE}

# Runtime dependencies from upstream's base_image stage, minus the language
# runtimes this config does not use (JRE, PHP, R, Ruby, Go, Dart, ...).
RUN apk add --no-cache \
  bash \
  ca-certificates \
  coreutils \
  curl \
  file \
  git \
  git-lfs \
  jq \
  libxml2-utils \
  nodejs-current \
  openssh-client \
  parallel \
  perl

SHELL ["/bin/bash", "-o", "errexit", "-o", "nounset", "-o", "pipefail", "-c"]

# --- binaries ---------------------------------------------------------------
# VALIDATE_EDITORCONFIG, VALIDATE_ENV, VALIDATE_GITHUB_ACTIONS, VALIDATE_GITLEAKS
COPY --from=upstream /usr/bin/editorconfig-checker /usr/bin/editorconfig-checker
COPY --from=upstream /usr/bin/dotenv-linter /usr/bin/dotenv-linter
COPY --from=upstream /usr/bin/actionlint /usr/bin/actionlint
COPY --from=upstream /usr/bin/gitleaks /usr/bin/gitleaks

# --- python venvs -----------------------------------------------------------
# VALIDATE_GITHUB_ACTIONS_ZIZMOR, VALIDATE_PYTHON_MYPY, VALIDATE_PYTHON_RUFF,
# VALIDATE_YAML
COPY --from=upstream /venvs/zizmor /venvs/zizmor
COPY --from=upstream /venvs/mypy /venvs/mypy
COPY --from=upstream /venvs/ruff /venvs/ruff
COPY --from=upstream /venvs/yamllint /venvs/yamllint

# --- npm tools --------------------------------------------------------------
# VALIDATE_JSON, VALIDATE_JSON_PRETTIER, VALIDATE_MARKDOWN,
# VALIDATE_NATURAL_LANGUAGE. Kept whole for now; pruning is a later experiment.
COPY --from=upstream /node_modules /node_modules

# --- super-linter itself ----------------------------------------------------
# Includes linter.sh, the config templates and /action/linterVersions.txt.
# NOTE: linterVersions.txt still lists every upstream tool. linter.sh only cats
# it, so it is harmless, but the compiler should filter it later.
COPY --from=upstream /action /action

ENV PATH="${PATH}:/venvs/mypy/bin:/venvs/ruff/bin:/venvs/yamllint/bin:/venvs/zizmor/bin:/node_modules/.bin"
ENV VERSION_FILE="/action/linterVersions.txt"
ENV IMAGE="lean"
ENV RENOVATE_X_IGNORE_RE2="true"
ENV ARM_TTK_PSD1="/usr/lib/microsoft/arm-ttk/arm-ttk.psd1"
ENV HOME="/github/home"

RUN mkdir -p "${HOME}" \
  && git config --system --add safe.directory "*"

WORKDIR /
ENTRYPOINT ["/action/lib/linter.sh"]
